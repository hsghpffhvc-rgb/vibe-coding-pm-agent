# Optional. Without any key the app runs on the built-in local engine.

# Any OpenAI-compatible endpoint (DashScope / Qwen, DeepSeek, OpenRouter, vLLM...).
# Omit OPENAI_BASE_URL to use https://api.openai.com/v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Reasoning models spend tokens on thinking before emitting content,
# so leave enough budget for the full 8-section document.
OPENAI_MAX_TOKENS=8192
OPENAI_TIMEOUT_MS=120000
# Reasoning models only: set false to spend the budget on output instead of thinking.
# Sent only when OPENAI_BASE_URL is set, since the OpenAI endpoint rejects unknown params.
OPENAI_ENABLE_THINKING=false

# Alternative provider, used when OPENAI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
